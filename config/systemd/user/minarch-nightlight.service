[Unit]
Description=Apply the saved Minarch night light setting
PartOf=minarch-session.target
ConditionEnvironment=DISPLAY

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/.local/bin/blix-settings-apply nightlight
ExecReload=%h/.local/bin/blix-settings-apply nightlight
ExecStop=/usr/bin/gammastep -m randr -x
