# shellcheck shell=bash
# Minarch: keep Bash close to stock.
[[ $- == *i* ]] || return
# Attach ble.sh after the prompt is configured, when the AUR package exists.
if [[ -r /usr/share/blesh/ble.sh ]]; then
  # ble.sh uses dynamic Bash syntax that shellcheck cannot parse as a source.
  # shellcheck disable=SC1091,SC1094
  source -- /usr/share/blesh/ble.sh --attach=none
fi
export PATH="$HOME/.local/bin:$PATH"
export EDITOR=vim
export VISUAL=vim
if command -v yay >/dev/null 2>&1; then
  alias update='yay -Syu --noconfirm'
else
  alias update='sudo pacman -Syu --noconfirm'
fi
if [[ -r /usr/share/bash-completion/bash_completion ]]; then
  # Provided by the target system's bash-completion package.
  # shellcheck disable=SC1091
  . /usr/share/bash-completion/bash_completion
fi
PS1='\u@\h:\w\$ '
[[ ! ${BLE_VERSION-} ]] || ble-attach
