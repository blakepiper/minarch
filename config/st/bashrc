# shellcheck shell=bash
[[ $- == *i* ]] || return 0
# Preserve the user's prompt, aliases, completion, and other shell settings.
# shellcheck disable=SC1090
[[ ! -r ~/.bashrc ]] || source ~/.bashrc
# The user's startup may already have loaded ble.sh.
if [[ ! ${BLE_VERSION-} && -r /usr/share/blesh/ble.sh ]]; then
  # shellcheck disable=SC1091,SC1094
  source -- /usr/share/blesh/ble.sh --attach=none
  [[ ! ${BLE_VERSION-} ]] || ble-attach
fi
