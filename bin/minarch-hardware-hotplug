#!/usr/bin/env bash
set -u

[[ -n ${DISPLAY:-} ]] || exit 0

profile=${XDG_CONFIG_HOME:-$HOME/.config}/minarch/hardware.conf
[[ -r $profile ]] || exit 0
keyboard_name='' keyboard_vendor='' keyboard_product='' keyboard_layout=us
keyboard_interfaces=2
keyboard_options=()
mirror_output='' mirror_source='' mirror_mode='' mirror_rate=''
# This is the user's shell configuration, installed with preservation/backups.
# shellcheck disable=SC1090
source "$profile" || exit 1
has_settings=false
if command -v blix-settings-apply >/dev/null; then has_settings=true; fi
[[ -n $keyboard_name || -n $mirror_output || $has_settings == true ]] || exit 0
[[ $keyboard_interfaces =~ ^[1-9][0-9]*$ ]] || {
  echo 'hardware.conf: keyboard_interfaces must be a positive integer' >&2
  exit 1
}

display_number=${DISPLAY##*:}
display_number=${display_number%%.*}
xorg_log_path="${XDG_DATA_HOME:-$HOME/.local/share}/xorg/Xorg.${display_number}.log"
runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
pid_path="$runtime_dir/minarch-hardware-hotplug-$UID.pid"
once_mode=0
[[ ${1:-} == --once ]] && once_mode=1

if (( ! once_mode )) && [[ -r $pid_path ]]; then
  read -r old_pid < "$pid_path" || old_pid=''
  if [[ $old_pid =~ ^[0-9]+$ ]] && [[ $old_pid != "$$" ]] && kill -0 "$old_pid" 2>/dev/null; then
    exit 0
  fi
fi
if (( ! once_mode )); then
  printf '%s\n' "$$" > "$pid_path" 2>/dev/null || exit 0
fi

monitor_pid=''
cleanup() {
  [[ -z $monitor_pid ]] || kill "$monitor_pid" 2>/dev/null || true
  (( once_mode )) || rm -f "$pid_path"
}
trap cleanup EXIT INT TERM

apply_keyboard() {
  local id option
  local -a ids=() options=()
  [[ -n $keyboard_name ]] || return 0
  [[ -r $xorg_log_path ]] || return 0

  mapfile -t ids < <(
    awk -v name="$keyboard_name" '
      BEGIN { prefix = "XINPUT: Adding extended input device \"" name "\" (type: KEYBOARD, id " }
      index($0, prefix) {
        id = substr($0, index($0, prefix) + length(prefix))
        sub(/\).*/, "", id)
        if (id ~ /^[0-9]+$/) print id
      }
    ' "$xorg_log_path" | tail -n "$keyboard_interfaces"
  )
  for option in "${keyboard_options[@]}"; do
    options+=(-option "$option")
  done
  for id in "${ids[@]}"; do
    setxkbmap -device "$id" \
      -option '' \
      "${options[@]}" "$keyboard_layout" -print |
      xkbcomp -synch -i "$id" - "$DISPLAY" >/dev/null 2>&1 || true
  done
}

configure_external_monitor() {
  local outputs status=0
  local -a startup_args=() settings=()
  if "$has_settings"; then
    if (( once_mode )); then
      startup_args+=(--fresh-session)
    fi
    BLIX_DISPLAY_LAYOUT=mirror BLIX_PRIMARY_OUTPUT="$mirror_source" BLIX_EXTERNAL_OUTPUT="$mirror_output" \
      BLIX_MIRROR_MODE="$mirror_mode" BLIX_MIRROR_RATE="$mirror_rate" \
      blix-settings-apply display-hotplug "${startup_args[@]}" || status=$?
    # Keep the shell mirror fallback for sessions without a usable settings plan.
    [[ $status == 2 ]] || return 0
  fi
  [[ -n $mirror_output && -n $mirror_source ]] || return 0
  command -v xrandr >/dev/null 2>&1 || return 0
  outputs=$(xrandr --query 2>/dev/null) || return 0
  if awk -v output="$mirror_output" -v source="$mirror_source" '
    $1 == output && $2 == "connected" { out = 1 }
    $1 == source && $2 == "connected" { src = 1 }
    END { exit !(out && src) }
  ' <<< "$outputs"; then
    if [[ -n $mirror_mode ]]; then settings+=(--mode "$mirror_mode"); else settings+=(--auto); fi
    [[ -z $mirror_rate ]] || settings+=(--rate "$mirror_rate")
    xrandr --output "$mirror_output" "${settings[@]}" --same-as "$mirror_source" >/dev/null 2>&1 || true
  fi
}

apply_keyboard
configure_external_monitor
[[ ${1:-} == --once ]] && exit 0

watch_hotplug() {
  local line action='' subsystem='' devname='' vendor='' model='' hotplug=''
  while IFS= read -r line; do
    case $line in
      '')
        case "$subsystem:$action" in
          input:add)
            if [[ -n $keyboard_vendor && -n $keyboard_product &&
                  $vendor == "$keyboard_vendor" && $model == "$keyboard_product" ]]; then
              sleep 1
              apply_keyboard
            elif "$has_settings" && [[ $devname == /dev/input/event* ]]; then
              sleep 0.8
            fi
            if "$has_settings" && [[ $devname == /dev/input/event* ]]; then
              blix-settings-apply apply-input
            fi ;;
          drm:change)
            if [[ $hotplug == 1 ]]; then
              sleep 1
              configure_external_monitor
              systemctl --user try-reload-or-restart minarch-nightlight.service || true
            fi ;;
          backlight:change)
            xprop -root -f _MINARCH_BRIGHTNESS 8s -set _MINARCH_BRIGHTNESS refresh >/dev/null ;;
        esac
        action='' subsystem='' devname='' vendor='' model='' hotplug='' ;;
      ACTION=*) action=${line#ACTION=} ;;
      SUBSYSTEM=*) subsystem=${line#SUBSYSTEM=} ;;
      DEVNAME=*) devname=${line#DEVNAME=} ;;
      ID_VENDOR_ID=*) vendor=${line#ID_VENDOR_ID=} ;;
      ID_MODEL_ID=*) model=${line#ID_MODEL_ID=} ;;
      HOTPLUG=*) hotplug=${line#HOTPLUG=} ;;
    esac
  done
}

filters=()
if [[ -n $keyboard_name || $has_settings == true ]]; then
  filters+=(--subsystem-match=input)
fi
if [[ ( -n $mirror_output && -n $mirror_source ) || $has_settings == true ]]; then
  filters+=(--subsystem-match=drm)
fi
if [[ ${MINARCH_BRIGHTNESS:-} == backlight ]]; then
  filters+=(--subsystem-match=backlight)
fi
if (( ${#filters[@]} )); then
  exec {monitor_fd}< <(exec udevadm monitor --udev --property "${filters[@]}" 2>/dev/null)
  monitor_pid=$!
  watch_hotplug <&"$monitor_fd"
  status=0
  wait "$monitor_pid" || status=$?
  monitor_pid=''
  exit "$status"
fi
