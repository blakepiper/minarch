#!/usr/bin/env bash
set -u

[[ -n ${DISPLAY:-} ]] || exit 0

profile=${XDG_CONFIG_HOME:-$HOME/.config}/minarch/hardware.conf
[[ -r $profile ]] || exit 0
keyboard_name='' keyboard_vendor='' keyboard_product='' keyboard_layout=us
keyboard_interfaces=2
keyboard_options=()
mirror_output='' mirror_source='' mirror_mode='' mirror_rate=''
# This is the user's shell configuration, installed with preservation/backups.
# shellcheck disable=SC1090
source "$profile" || exit 1
[[ -n $keyboard_name || -n $mirror_output ]] || exit 0
[[ $keyboard_interfaces =~ ^[1-9][0-9]*$ ]] || {
  echo 'hardware.conf: keyboard_interfaces must be a positive integer' >&2
  exit 1
}

display_number=${DISPLAY##*:}
display_number=${display_number%%.*}
xorg_log_path="${XDG_DATA_HOME:-$HOME/.local/share}/xorg/Xorg.${display_number}.log"
runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
pid_path="$runtime_dir/minarch-hardware-hotplug-$UID.pid"
once_mode=0
[[ ${1:-} == --once ]] && once_mode=1

if (( ! once_mode )) && [[ -r $pid_path ]]; then
  read -r old_pid < "$pid_path" || old_pid=''
  if [[ $old_pid =~ ^[0-9]+$ ]] && [[ $old_pid != "$$" ]] && kill -0 "$old_pid" 2>/dev/null; then
    exit 0
  fi
fi
if (( ! once_mode )); then
  printf '%s\n' "$$" > "$pid_path" 2>/dev/null || exit 0
fi

input_monitor_pid=''
display_monitor_pid=''
monitor_pids=()
cleanup() {
  [[ -z $input_monitor_pid ]] || kill "$input_monitor_pid" 2>/dev/null || true
  [[ -z $display_monitor_pid ]] || kill "$display_monitor_pid" 2>/dev/null || true
  (( once_mode )) || rm -f "$pid_path"
}
trap cleanup EXIT INT TERM

apply_keyboard() {
  local id option
  local -a ids=() options=()
  [[ -n $keyboard_name ]] || return 0
  [[ -r $xorg_log_path ]] || return 0

  mapfile -t ids < <(
    awk -v name="$keyboard_name" '
      BEGIN { prefix = "XINPUT: Adding extended input device \"" name "\" (type: KEYBOARD, id " }
      index($0, prefix) {
        id = substr($0, index($0, prefix) + length(prefix))
        sub(/\).*/, "", id)
        if (id ~ /^[0-9]+$/) print id
      }
    ' "$xorg_log_path" | tail -n "$keyboard_interfaces"
  )
  for option in "${keyboard_options[@]}"; do
    options+=(-option "$option")
  done
  for id in "${ids[@]}"; do
    setxkbmap -device "$id" \
      -option '' \
      "${options[@]}" "$keyboard_layout" -print |
      xkbcomp -synch -i "$id" - "$DISPLAY" >/dev/null 2>&1 || true
  done
}

configure_external_monitor() {
  local outputs
  local -a settings=()
  [[ -n $mirror_output && -n $mirror_source ]] || return 0
  command -v xrandr >/dev/null 2>&1 || return 0
  outputs=$(xrandr --query 2>/dev/null) || return 0
  if awk -v output="$mirror_output" -v source="$mirror_source" '
    $1 == output && $2 == "connected" { out = 1 }
    $1 == source && $2 == "connected" { src = 1 }
    END { exit !(out && src) }
  ' <<< "$outputs"; then
    if [[ -n $mirror_mode ]]; then settings+=(--mode "$mirror_mode"); else settings+=(--auto); fi
    [[ -z $mirror_rate ]] || settings+=(--rate "$mirror_rate")
    xrandr --output "$mirror_output" "${settings[@]}" --same-as "$mirror_source" >/dev/null 2>&1 || true
  fi
}

apply_keyboard
configure_external_monitor
[[ ${1:-} == --once ]] && exit 0

watch_keyboard() {
  local line action='' vendor='' model=''
  while IFS= read -r line; do
    if [[ -z $line ]]; then
      if [[ $action == add && -n $keyboard_vendor && -n $keyboard_product &&
            $vendor == "$keyboard_vendor" && $model == "$keyboard_product" ]]; then
        sleep 1
        apply_keyboard
      fi
      action=''
      vendor=''
      model=''
    elif [[ $line == ACTION=* ]]; then
      action=${line#ACTION=}
    elif [[ $line == ID_VENDOR_ID=* ]]; then
      vendor=${line#ID_VENDOR_ID=}
    elif [[ $line == ID_MODEL_ID=* ]]; then
      model=${line#ID_MODEL_ID=}
    fi
  done
}

watch_display() {
  local line action='' hotplug=''
  while IFS= read -r line; do
    if [[ -z $line ]]; then
      if [[ $action == change && $hotplug == 1 ]]; then
        sleep 1
        configure_external_monitor
      fi
      action=''
      hotplug=''
    elif [[ $line == ACTION=* ]]; then
      action=${line#ACTION=}
    elif [[ $line == HOTPLUG=* ]]; then
      hotplug=${line#HOTPLUG=}
    fi
  done
}

if [[ -n $keyboard_name ]]; then
  udevadm monitor --udev --property --subsystem-match=input 2>/dev/null | watch_keyboard &
  input_monitor_pid=$!
  monitor_pids+=("$input_monitor_pid")
fi
if [[ -n $mirror_output && -n $mirror_source ]]; then
  udevadm monitor --udev --property --subsystem-match=drm 2>/dev/null | watch_display &
  display_monitor_pid=$!
  monitor_pids+=("$display_monitor_pid")
fi
wait "${monitor_pids[@]}"
