#!/usr/bin/env bash
# Resolve the same configuration directory used by the installer.
config=${XDG_CONFIG_HOME:-$HOME/.config}/picom/picom.conf
if grep -Fq '# @minarch-opacity-override@' "$config" &&
  generated=$(blix-settings-apply prepare-picom); then
  config=$generated
fi
exec picom --config "$config" "$@"
