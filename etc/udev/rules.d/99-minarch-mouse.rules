# Xorg's udev backend reads ID_INPUT.tags, not the systemd TAGS property.
# Do not apply mouse scrolling settings to touchpads, tablets, or pointing sticks.
ACTION!="remove", SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_MOUSE}=="1", ENV{ID_INPUT_POINTINGSTICK}!="1", ENV{ID_INPUT_TOUCHPAD}!="1", ENV{ID_INPUT_TABLET}!="1", ENV{ID_INPUT.tags}="$env{ID_INPUT.tags},minarch-mouse"
